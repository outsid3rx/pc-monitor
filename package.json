{
  "name": "resource-display",
  "version": "1.0.0",
  "description": "PC resources monitoring with arduino device",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "build:watch": "tsc --watch",
    "start:watch": "node --watch dist/index.js",
    "lint": "eslint --ext .ts,.js ./src/*",
    "lint:fix": "eslint --fix --ext .ts,.js ./src/*"
  },
  "keywords": ["monitoring", "pc", "serialport", "arduino"],
  "author": "Max Zernyaev",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.7.7",
    "eslint": "^8.56.0",
    "eslint-kit": "^11.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "serialport": "^12.0.0",
    "systeminformation": "^5.23.5"
  }
}
